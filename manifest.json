{
  "manifest_version": 3,
  "name": "AI 全球情报雷达",
  "version": "0.1.1",
  "description": "聚合全球 AI 更新、海外 AI 课程热度与重要新闻。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.github.com/*",
    "https://export.arxiv.org/*",
    "https://hn.algolia.com/*",
    "https://www.reddit.com/*",
    "https://openai.com/*",
    "https://blog.google/*",
    "https://deepmind.google/*",
    "https://blogs.microsoft.com/*",
    "https://blogs.nvidia.com/*",
    "https://news.mit.edu/*",
    "https://www.classcentral.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 AI 全球情报雷达"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.svg", "icons/icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
